FROM node:22-slim

WORKDIR /workspace
RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml turbo.json ./
COPY apps/web/package.json apps/web/package.json
COPY apps/web/prisma apps/web/prisma
COPY apps/web/prisma.config.ts apps/web/prisma.config.ts
COPY packages packages
RUN DATABASE_URL=postgresql://local:local@127.0.0.1:5432/build_only pnpm install --frozen-lockfile

COPY apps/web apps/web
RUN DATABASE_URL=postgresql://local:local@127.0.0.1:5432/build_only pnpm --filter web exec prisma generate

WORKDIR /workspace/apps/web
CMD ["pnpm", "run", "worker:notifications"]
