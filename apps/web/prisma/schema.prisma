// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum NotificationType {
  DISCUSSION_CREATED
  COMMENT_CREATED
  MENTION
}

enum DecisionStatus {
  PROPOSED
  DECIDED
  SUPERSEDED
}

enum DecisionRevisionAction {
  CREATE
  EDIT
  FINALIZE
  SUPERSEDE
  SOFT_DELETE
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  username      String            @unique
  passwordHash  String?
  name          String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  ownedSpaces   Workspace[]
  memberships   WorkspaceMember[]
  discussions   Discussion[]
  comments      Comment[]
  decisionsCreated Decision[] @relation("DecisionCreator")
  decisionsDeleted Decision[] @relation("DecisionDeleter")
  decisionRevisions DecisionRevision[] @relation("DecisionRevisionActor")
  supersessionsAuthorized DecisionSupersession[] @relation("DecisionSupersessionAuthorizer")
  notificationsReceived Notification[] @relation("NotificationRecipient")
  notificationsSent     Notification[] @relation("NotificationActor")
}

model Workspace {
  id          String            @id @default(cuid())
  name        String
  slug        String            @unique
  ownerId     String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  owner       User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  members     WorkspaceMember[]
  discussions Discussion[]
  comments    Comment[]
  decisions   Decision[]
  notifications Notification[]

  @@index([ownerId, createdAt])
  // Recommended (optional): @@index([createdAt]) for global recent-workspaces feeds.
}

model Discussion {
  id          String    @id @default(cuid())
  workspaceId String
  authorId    String
  title       String
  body        String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author      User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments    Comment[]
  sourceDecisions Decision[]
  notifications Notification[]

  @@index([workspaceId, createdAt])
  @@unique([workspaceId, id])
  @@index([authorId, createdAt])
  // Recommended (optional): @@index([workspaceId, updatedAt]) for active-discussion sort views.
}

model Comment {
  id              String    @id @default(cuid())
  discussionId    String
  workspaceId     String
  authorId        String
  parentCommentId String?
  depth           Int       @default(0)
  body            String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  discussion      Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  workspace       Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author          User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentComment   Comment?   @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]  @relation("CommentReplies")
  notifications   Notification[]

  @@index([discussionId, parentCommentId, id(sort: Desc)])
  @@index([workspaceId, discussionId, id(sort: Desc)])
  @@index([authorId, createdAt])
  // Recommended (optional): @@index([discussionId, createdAt]) for chronological thread views.
}

model Notification {
  id              String           @id @default(cuid())
  recipientUserId String
  actorUserId     String?
  workspaceId     String
  discussionId    String?
  commentId       String?
  type            NotificationType
  message         String
  metadata        Json?
  dedupeKey       String           @unique
  readAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recipient       User             @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor           User?            @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  discussion      Discussion?      @relation(fields: [discussionId], references: [id], onDelete: SetNull)
  comment         Comment?         @relation(fields: [commentId], references: [id], onDelete: SetNull)

  @@index([recipientUserId, id(sort: Desc)])
  @@index([recipientUserId, readAt, id(sort: Desc)])
  @@index([workspaceId, recipientUserId, id(sort: Desc)])
  @@index([discussionId, recipientUserId, id(sort: Desc)])
  // Recommended (optional): @@index([recipientUserId, createdAt]) for time-sorted analytics.
}

model WorkspaceMember {
  id          String         @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole  @default(MEMBER)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@index([userId, createdAt])
  // Recommended (optional): @@index([userId, workspaceId, role]) for permission-heavy joins.
}

// Decisions remain workspace records when their source discussion is deleted.
// The source-pair CHECK constraint and three deferred FK checks on revision
// and supersession rows are kept in the reviewed SQL migration because Prisma
// cannot express them. CASCADE and SET NULL actions themselves remain immediate.
model Decision {
  id                       String         @id @default(cuid())
  workspaceId              String
  sourceWorkspaceId        String?
  sourceDiscussionId       String?
  sourceDiscussionTitle    String
  createdById              String?
  createdByLabel           String
  deletedById              String?
  question                 String
  outcome                  String?
  rationale                String?
  alternatives             String?
  followUp                 String?
  status                   DecisionStatus @default(PROPOSED)
  version                  Int            @default(1)
  idempotencyKey           String         @unique
  creationPayloadHash      String?
  decidedAt                DateTime?
  supersededAt             DateTime?
  deletedAt                DateTime?
  createdAt                DateTime       @default(now())
  updatedAt                DateTime       @updatedAt
  workspace                Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceDiscussion         Discussion?    @relation(fields: [sourceWorkspaceId, sourceDiscussionId], references: [workspaceId, id], onDelete: SetNull)
  createdBy                User?          @relation("DecisionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deletedBy                User?          @relation("DecisionDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  revisions                DecisionRevision[]
  replacementLink          DecisionSupersession? @relation("PreviousDecision")
  predecessorLink          DecisionSupersession? @relation("ReplacementDecision")

  @@unique([workspaceId, id])
  @@index([workspaceId, status, id(sort: Desc)])
  @@index([sourceWorkspaceId, sourceDiscussionId])
}

model DecisionRevision {
  id            String                 @id @default(cuid())
  decisionId    String
  version       Int
  action        DecisionRevisionAction
  actorUserId   String?
  actorLabel    String
  reason        String?
  question      String
  outcome       String?
  rationale     String?
  alternatives  String?
  followUp      String?
  status        DecisionStatus
  createdAt     DateTime               @default(now())
  decision      Decision               @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  actor         User?                  @relation("DecisionRevisionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([decisionId, version])
}

model DecisionSupersession {
  id                    String   @id @default(cuid())
  workspaceId           String
  previousDecisionId    String
  replacementDecisionId String
  reason                String
  authorizedById        String?
  authorizedByLabel     String
  createdAt             DateTime @default(now())
  previousDecision      Decision @relation("PreviousDecision", fields: [workspaceId, previousDecisionId], references: [workspaceId, id], onDelete: Cascade)
  replacementDecision   Decision @relation("ReplacementDecision", fields: [workspaceId, replacementDecisionId], references: [workspaceId, id], onDelete: Cascade)
  authorizedBy          User?    @relation("DecisionSupersessionAuthorizer", fields: [authorizedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, previousDecisionId])
  @@unique([workspaceId, replacementDecisionId])
}
