// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum WorkspaceRole {
  OWNER
  ADMIN
  MEMBER
}

enum NotificationType {
  DISCUSSION_CREATED
  COMMENT_CREATED
  MENTION
  REVIEW_REQUESTED
  REVIEW_RESPONDED
}

enum DecisionStatus {
  PROPOSED
  DECIDED
  SUPERSEDED
}

enum DigestDeliveryStatus {
  SENDING
  SENT
  SKIPPED_EMPTY
  SKIPPED_OFF
  HELD
  FAILED
}

enum FollowState {
  FOLLOWING
  MUTED
}

enum DecisionReviewRule {
  ALL
  AT_LEAST
}

enum DecisionReviewState {
  PENDING
  APPROVED
  OBJECTED
  WITHDRAWN
}

enum DecisionRevisionAction {
  CREATE
  EDIT
  FINALIZE
  SUPERSEDE
  SOFT_DELETE
}

model User {
  id                       String                  @id @default(cuid())
  email                    String                  @unique
  username                 String                  @unique
  passwordHash             String?
  name                     String?
  createdAt                DateTime                @default(now())
  updatedAt                DateTime                @updatedAt
  ownedSpaces              Workspace[]
  memberships              WorkspaceMember[]
  discussions              Discussion[]
  comments                 Comment[]
  decisionsCreated         Decision[]              @relation("DecisionCreator")
  decisionsDeleted         Decision[]              @relation("DecisionDeleter")
  decisionRevisions        DecisionRevision[]      @relation("DecisionRevisionActor")
  supersessionsAuthorized  DecisionSupersession[]  @relation("DecisionSupersessionAuthorizer")
  decisionReviews          DecisionReview[]        @relation("DecisionReviewer")
  reactions                Reaction[]
  discussionFollows        DiscussionFollow[]
  commentsPinned           Comment[]               @relation("CommentPinner")
  savedItems               SavedItem[]
  digestDeliveries         DigestDelivery[]
  digestPreference         DigestPreference?
  digestOptOuts            DigestWorkspaceOptOut[]
  decisionReviewsRequested DecisionReview[]        @relation("DecisionReviewRequester")
  notificationsReceived    Notification[]          @relation("NotificationRecipient")
  notificationsSent        Notification[]          @relation("NotificationActor")
  activityEvents           ActivityEvent[]
  attachmentsUploaded      Attachment[]
}

model Workspace {
  id                String                  @id @default(cuid())
  name              String
  slug              String                  @unique
  ownerId           String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  // Restrict: deleting a user must not silently delete the workspaces they own.
  // Transfer ownership or delete the workspace first.
  owner             User                    @relation(fields: [ownerId], references: [id], onDelete: Restrict)
  members           WorkspaceMember[]
  discussions       Discussion[]
  comments          Comment[]
  decisions         Decision[]
  decisionReviews   DecisionReview[]
  reactions         Reaction[]
  discussionFollows DiscussionFollow[]
  savedItems        SavedItem[]
  digestOptOuts     DigestWorkspaceOptOut[]
  notifications     Notification[]
  activityEvents    ActivityEvent[]
  attachments       Attachment[]
  // Recommended (optional): @@index([createdAt]) for global recent-workspaces feeds.

  @@index([ownerId, createdAt])
}

model Discussion {
  id              String                   @id @default(cuid())
  workspaceId     String
  authorId        String
  title           String
  body            String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author          User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments        Comment[]
  sourceDecisions Decision[]
  notifications   Notification[]
  // Full-text search vector, generated by PostgreSQL (migration 20261123_search_indexes).
  searchVector    Unsupported("tsvector")? @default(dbgenerated())

  reactions   Reaction[]
  follows     DiscussionFollow[]
  savedItems  SavedItem[]
  attachments Attachment[]
  // Recommended (optional): @@index([workspaceId, updatedAt]) for active-discussion sort views.

  @@unique([workspaceId, id])
  @@index([searchVector], type: Gin)
  @@index([workspaceId, createdAt])
  @@index([authorId, createdAt])
}

model Comment {
  id              String                   @id @default(cuid())
  discussionId    String
  workspaceId     String
  authorId        String
  parentCommentId String?
  depth           Int                      @default(0)
  body            String
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  discussion      Discussion               @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  workspace       Workspace                @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  author          User                     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parentComment   Comment?                 @relation("CommentReplies", fields: [parentCommentId], references: [id], onDelete: Cascade)
  replies         Comment[]                @relation("CommentReplies")
  notifications   Notification[]
  // Full-text search vector, generated by PostgreSQL (migration 20261123_search_indexes).
  searchVector    Unsupported("tsvector")? @default(dbgenerated())

  reactions   Reaction[]
  savedItems  SavedItem[]
  attachments Attachment[]
  // Pinned to the top of its discussion by the author or a manager
  // (Markdown, reactions, follow and pin PRD, FR-13 to FR-15).
  pinnedAt    DateTime?
  pinnedById  String?
  pinnedBy    User?        @relation("CommentPinner", fields: [pinnedById], references: [id], onDelete: SetNull)
  // Recommended (optional): @@index([discussionId, createdAt]) for chronological thread views.

  @@index([searchVector], type: Gin)
  @@index([discussionId, parentCommentId, id(sort: Desc)])
  @@index([workspaceId, discussionId, id(sort: Desc)])
  @@index([authorId, createdAt])
  @@index([discussionId, pinnedAt])
}

model Notification {
  id              String           @id @default(cuid())
  recipientUserId String
  actorUserId     String?
  workspaceId     String
  discussionId    String?
  commentId       String?
  type            NotificationType
  message         String
  metadata        Json?
  dedupeKey       String           @unique
  readAt          DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  recipient       User             @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  actor           User?            @relation("NotificationActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  workspace       Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  discussion      Discussion?      @relation(fields: [discussionId], references: [id], onDelete: SetNull)
  comment         Comment?         @relation(fields: [commentId], references: [id], onDelete: SetNull)
  // Recommended (optional): @@index([recipientUserId, createdAt]) for time-sorted analytics.

  @@index([recipientUserId, id(sort: Desc)])
  @@index([recipientUserId, readAt, id(sort: Desc)])
  @@index([workspaceId, recipientUserId, id(sort: Desc)])
  @@index([discussionId, recipientUserId, id(sort: Desc)])
}

model WorkspaceMember {
  id          String        @id @default(cuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(MEMBER)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Recommended (optional): @@index([userId, workspaceId, role]) for permission-heavy joins.

  @@unique([workspaceId, userId])
  @@index([workspaceId, role])
  @@index([userId, createdAt])
}

// Decisions remain workspace records when their source discussion is deleted.
// The source-pair CHECK constraint and three deferred FK checks on revision
// and supersession rows are kept in the reviewed SQL migration because Prisma
// cannot express them. CASCADE and SET NULL actions themselves remain immediate.
model Decision {
  id                    String                @id @default(cuid())
  workspaceId           String
  sourceWorkspaceId     String?
  sourceDiscussionId    String?
  sourceDiscussionTitle String
  createdById           String?
  createdByLabel        String
  deletedById           String?
  question              String
  outcome               String?
  rationale             String?
  alternatives          String?
  followUp              String?
  status                DecisionStatus        @default(PROPOSED)
  // Review rule (decision reviews PRD, FR-2): everyone asked must approve, or
  // at least requiredApprovals of them. Only meaningful once reviewers exist.
  reviewRule            DecisionReviewRule    @default(ALL)
  requiredApprovals     Int?
  version               Int                   @default(1)
  idempotencyKey        String                @unique
  creationPayloadHash   String?
  decidedAt             DateTime?
  supersededAt          DateTime?
  deletedAt             DateTime?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  workspace             Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  sourceDiscussion      Discussion?           @relation(fields: [sourceWorkspaceId, sourceDiscussionId], references: [workspaceId, id], onDelete: SetNull)
  createdBy             User?                 @relation("DecisionCreator", fields: [createdById], references: [id], onDelete: SetNull)
  deletedBy             User?                 @relation("DecisionDeleter", fields: [deletedById], references: [id], onDelete: SetNull)
  revisions             DecisionRevision[]
  reviews               DecisionReview[]
  savedItems            SavedItem[]
  attachments           Attachment[]
  replacementLink       DecisionSupersession? @relation("PreviousDecision")
  predecessorLink       DecisionSupersession? @relation("ReplacementDecision")

  // Full-text search vector, generated by PostgreSQL (migration 20261123_search_indexes).
  searchVector Unsupported("tsvector")? @default(dbgenerated())

  @@unique([workspaceId, id])
  @@index([searchVector], type: Gin)
  @@index([workspaceId, status, id(sort: Desc)])
  @@index([sourceWorkspaceId, sourceDiscussionId])
}

model DecisionRevision {
  id             String                 @id @default(cuid())
  decisionId     String
  version        Int
  action         DecisionRevisionAction
  actorUserId    String?
  actorLabel     String
  reason         String?
  // Set when a manager finalized without the review rule being met (FR-9).
  overrideReason String?
  question       String
  outcome        String?
  rationale      String?
  alternatives   String?
  followUp       String?
  status         DecisionStatus
  createdAt      DateTime               @default(now())
  decision       Decision               @relation(fields: [decisionId], references: [id], onDelete: Cascade)
  actor          User?                  @relation("DecisionRevisionActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([decisionId, version])
}

// One reviewer asked to review one proposal (decision reviews PRD). The row
// keeps its latest state; every change is also written to the event log.
// Hand-written CHECK constraints in the migration: an objection needs a note,
// and requiredApprovals is at least 1.
model DecisionReview {
  id               String              @id @default(cuid())
  workspaceId      String
  decisionId       String
  reviewerId       String?
  reviewerLabel    String
  requestedById    String?
  requestedByLabel String
  state            DecisionReviewState @default(PENDING)
  note             String?
  // The decision version the latest response applies to.
  respondedVersion Int?
  respondedAt      DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  workspace        Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  decision         Decision            @relation(fields: [workspaceId, decisionId], references: [workspaceId, id], onDelete: Cascade)
  reviewer         User?               @relation("DecisionReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  requestedBy      User?               @relation("DecisionReviewRequester", fields: [requestedById], references: [id], onDelete: SetNull)

  @@unique([decisionId, reviewerId])
  @@index([workspaceId, decisionId])
  @@index([reviewerId, state])
}

// Who hears about new replies in a discussion (Markdown, reactions, follow and
// pin PRD, FR-9 to FR-12). FOLLOWING gets reply notifications; MUTED gets
// none and is not re-followed by replying. Mentions notify either way.
model DiscussionFollow {
  id           String      @id @default(cuid())
  workspaceId  String
  discussionId String
  userId       String
  state        FollowState @default(FOLLOWING)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  discussion   Discussion  @relation(fields: [workspaceId, discussionId], references: [workspaceId, id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId])
  @@index([userId])
}

// Daily digest preferences (daily digest PRD, FR-9): no row means on.
model DigestPreference {
  userId    String   @id
  enabled   Boolean  @default(true)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// A workspace a member left out of their digest (FR-9, FR-10).
model DigestWorkspaceOptOut {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
}

// One row per member and day of the daily digest (daily digest PRD, FR-6 to
// FR-8): the unique key makes sending at most once a day, and the row records
// what happened. SENDING claims the row before sending, so overlapping runs
// never both send; HELD means built but not sent because of the allow list.
model DigestDelivery {
  id         String               @id @default(cuid())
  userId     String
  digestDate DateTime             @db.Date
  status     DigestDeliveryStatus
  providerId String?
  attempts   Int                  @default(0)
  error      String?
  createdAt  DateTime             @default(now())
  updatedAt  DateTime             @updatedAt
  user       User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, digestDate])
  @@index([digestDate, status])
}

// A discussion, reply or decision a member saved for later (Markdown,
// reactions, follow and pin PRD, FR-16 to FR-18). Private to the member.
// Exactly one target is set (CHECK constraint in the migration); saved items
// are deleted with their discussion or reply, and hidden for deleted decisions.
model SavedItem {
  id           String      @id @default(cuid())
  userId       String
  workspaceId  String
  discussionId String?
  commentId    String?
  decisionId   String?
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  discussion   Discussion? @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  comment      Comment?    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  decision     Decision?   @relation(fields: [workspaceId, decisionId], references: [workspaceId, id], onDelete: Cascade)

  @@unique([userId, discussionId])
  @@unique([userId, commentId])
  @@unique([userId, decisionId])
  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, workspaceId])
}

// An emoji reaction on a discussion or a reply (Markdown PRD, FR-6 to FR-8).
// Exactly one of discussionId and commentId is set (CHECK constraint in the
// migration); reactions are deleted with their discussion or reply.
model Reaction {
  id           String      @id @default(cuid())
  workspaceId  String
  discussionId String?
  commentId    String?
  userId       String
  emoji        String
  createdAt    DateTime    @default(now())
  workspace    Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  discussion   Discussion? @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  comment      Comment?    @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([discussionId, userId, emoji])
  @@unique([commentId, userId, emoji])
  @@index([workspaceId, discussionId])
  @@index([commentId])
}

model DecisionSupersession {
  id                    String   @id @default(cuid())
  workspaceId           String
  previousDecisionId    String
  replacementDecisionId String
  reason                String
  authorizedById        String?
  authorizedByLabel     String
  createdAt             DateTime @default(now())
  previousDecision      Decision @relation("PreviousDecision", fields: [workspaceId, previousDecisionId], references: [workspaceId, id], onDelete: Cascade)
  replacementDecision   Decision @relation("ReplacementDecision", fields: [workspaceId, replacementDecisionId], references: [workspaceId, id], onDelete: Cascade)
  authorizedBy          User?    @relation("DecisionSupersessionAuthorizer", fields: [authorizedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, previousDecisionId])
  @@unique([workspaceId, replacementDecisionId])
}

enum ActivityKind {
  WORKSPACE_CREATED
  WORKSPACE_UPDATED
  MEMBER_ADDED
  MEMBER_ROLE_CHANGED
  MEMBER_REMOVED
  OWNERSHIP_TRANSFERRED
  DISCUSSION_CREATED
  DISCUSSION_UPDATED
  DISCUSSION_DELETED
  COMMENT_CREATED
  COMMENT_UPDATED
  COMMENT_DELETED
  DECISION_PROPOSED
  DECISION_EDITED
  DECISION_FINALIZED
  DECISION_SUPERSEDED
  DECISION_DELETED
  DECISION_REVIEW_REQUESTED
  DECISION_REVIEW_RESPONDED
  DECISION_REVIEW_WITHDRAWN
  DECISION_REVIEWS_RESET
  DECISION_REVIEW_RULE_CHANGED
  COMMENT_PINNED
  COMMENT_UNPINNED
}

enum ActivitySubjectType {
  WORKSPACE
  MEMBER
  DISCUSSION
  COMMENT
  DECISION
}

// Append-only record of what happened in a workspace, written in the same
// transaction as the change it describes. Feeds, digests and search indexing
// read it; nothing updates or deletes a row except workspace deletion.
model ActivityEvent {
  id          String              @id @default(cuid())
  workspaceId String
  actorUserId String?
  actorLabel  String
  kind        ActivityKind
  subjectType ActivitySubjectType
  subjectId   String
  // A small snapshot such as a title or roles; never full bodies.
  summary     Json?
  createdAt   DateTime            @default(now())
  workspace   Workspace           @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?               @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([subjectType, subjectId])
  @@index([actorUserId])
}

enum AttachmentStatus {
  PENDING
  ATTACHED
}

// A file uploaded to storage (file uploads PRD). PENDING from the moment an
// upload URL is issued until a post claims it; then ATTACHED to exactly one
// discussion, reply or decision (CHECK constraints in the migration). Deleting
// a row, directly or by cascade, records its key in DeletedFile (a trigger),
// and the daily clean-up deletes the object from storage.
model Attachment {
  id           String           @id @default(cuid())
  workspaceId  String
  uploaderId   String?
  // Random and name-free: files/<workspaceId>/<random> (NFR-1).
  key          String           @unique
  fileName     String
  contentType  String
  size         Int
  status       AttachmentStatus @default(PENDING)
  discussionId String?
  commentId    String?
  decisionId   String?
  position     Int              @default(0)
  createdAt    DateTime         @default(now())
  attachedAt   DateTime?
  workspace    Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploader     User?            @relation(fields: [uploaderId], references: [id], onDelete: SetNull)
  discussion   Discussion?      @relation(fields: [workspaceId, discussionId], references: [workspaceId, id], onDelete: Cascade)
  comment      Comment?         @relation(fields: [commentId], references: [id], onDelete: Cascade)
  decision     Decision?        @relation(fields: [workspaceId, decisionId], references: [workspaceId, id], onDelete: Cascade)

  @@index([workspaceId, status])
  @@index([status, createdAt])
  @@index([discussionId, position])
  @@index([commentId, position])
  @@index([decisionId, position])
}

// Storage objects whose Attachment row is gone, waiting for the clean-up job
// to delete them (file uploads PRD, FR-12). Written only by a trigger.
model DeletedFile {
  key       String   @id
  deletedAt DateTime @default(now())

  @@index([deletedAt])
}
