    "test:auth": "node --test server/api/trpc.auth.test.mjs",
    "test:workspace-security": "node --test server/services/workspace.permissions.test.mjs server/middleware/rateLimit.test.mjs",
    "test:discussion-security": "node --test server/api/discussion.security.test.mjs",
    "test:comment-security": "node --test server/api/comment.security.test.mjs",
    "test:integration": "node --test server/api/integration.test.mjs"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.33.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.0",
    "@prisma/adapter-pg": "7.3.0",
    "@prisma/client": "^7.3.0",
    "@repo/validators": "workspace:*",
    "@sentry/node": "^8.26.0",
    "@tanstack/react-query": "^5.90.21",
    "@trpc/client": "^11.10.0",
    "@trpc/next": "^11.10.0",
    "@trpc/react-query": "^11.10.0",
    "@trpc/server": "^11.10.0",
    "argon2": "^0.41.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.67.3",
    "dotenv": "^17.3.1",
    "framer-motion": "^12.34.0",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "next": "16.1.6",
    "pg": "8.16.3",
    "prisma": "^7.3.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.62.0",
    "superjson": "^2.2.6",
    "tsx": "4.20.6",
    "zod": "^4.3.6",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
