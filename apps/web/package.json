{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "postinstall": "prisma generate",
    "build": "next build --webpack",
    "db:migrate:deploy": "prisma migrate deploy",
    "worker:notifications": "tsx server/queue/workers/notification.entry.ts",
    "start": "next start",
    "lint": "eslint",
    "check-types": "tsc --noEmit --incremental false",
